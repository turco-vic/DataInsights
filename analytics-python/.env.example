# Copie este arquivo para ".env" (copy .env.example .env) e preencha com os dados do servidor Azure.
# São os mesmos dados do backend (BackEnd/src/main/resources/application.properties).
# O arquivo .env nunca vai para o Git (tem senha!).
DB_HOST=eturcodev.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=eturcodevadmin
DB_PASSWORD=sua-senha
DB_SSLMODE=require

# Chave combinada com o backend (ETL_KEY). Vazio = sem chave (só para estudar no seu computador).
ETL_API_KEY=
